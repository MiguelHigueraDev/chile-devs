# =============================================================================
# Chile Devs — Backend environment
# Copy to .env and fill in secrets before running the API.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

PORT=3000
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Data stores
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://chile_devs:chile_devs@localhost:5432/chile_devs

# Also used for rate-limit counters, ban state, and discovery rotation
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth & admin
# -----------------------------------------------------------------------------

# Random string used to sign session cookies (required)
SESSION_SECRET=your_random_session_secret_here

# GitHub OAuth — required for profile claiming
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Comma-separated GitHub logins with admin access (seed with `pnpm db:seed-admins`)
ADMIN_GITHUB_LOGINS=your_github_login

# -----------------------------------------------------------------------------
# GitHub API
# -----------------------------------------------------------------------------

# Personal access token — required to sync developer and repo data
GITHUB_TOKEN=ghp_your_personal_access_token_here

# -----------------------------------------------------------------------------
# Sync
# -----------------------------------------------------------------------------

# Bearer token for POST /api/sync and POST /api/sync/user
SYNC_TOKEN=your_sync_endpoint_secret_here

# Hours to cache GitHub enrichment responses in Redis
SYNC_ENRICHMENT_TTL_HOURS=24

# Hours to cache per-repo commit activity in Redis
ACTIVITY_CACHE_TTL_HOURS=10

# -----------------------------------------------------------------------------
# Candidate discovery (admin “Refresh repos”)
# See backend/src/discovery/README.md for how these interact.
# -----------------------------------------------------------------------------

# Repos selected per Chilean region / nationwide
DISCOVERY_TOP_PER_REGION=10
DISCOVERY_TOP_COUNTRY=50

# Developers scanned per refresh and repos fetched per dev from GitHub
DISCOVERY_TOP_DEVS=300
DISCOVERY_REPOS_PER_DEV=10

# Rotation: skip explored devs until this fraction of the full pool is seen, then reset
DISCOVERY_DEV_ROTATION_FRACTION=0.2

# Skip devs who already have this many promoted repos on the map
DISCOVERY_FEATURED_REPO_CAP=2

# How long explored-dev IDs persist in Redis (survives redeploys within this window)
DISCOVERY_EXPLORED_DEVS_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Optional / reserved
# -----------------------------------------------------------------------------

# Currently unused; reserved for possible future AI features
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here
